FROM node:20-alpine

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json* ./ 

RUN npm install

COPY frontend ./frontend

WORKDIR /app/frontend

ENV NEXT_PUBLIC_API_BASE_URL=http://backend:8000

EXPOSE 3000

CMD ["npm", "run", "dev", "--", "--port", "3000", "--hostname", "0.0.0.0"]

